# =============================================================================
# Personal Finance App - Variables de Entorno
# =============================================================================
# Copia este archivo a .env y configura tus valores

# --- Contraseña para PDFs protegidos ---
PDF_PASSWORD=tu_contraseña_aqui

# --- Configuración de Email ---
# Habilitar/Deshabilitar envío de email (1 = habilitado, 0 = deshabilitado)
EMAIL_ENABLED=0

# Configuración del servidor SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Credenciales de email
EMAIL_SENDER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password_aqui

# Destinatario del reporte
EMAIL_RECIPIENT=destinatario@email.com

# Asunto del email (opcional, tiene valor por defecto)
EMAIL_SUBJECT=Reporte de Consumos - Personal Finance App

