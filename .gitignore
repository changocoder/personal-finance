# =============================================================================
# Personal Finance App - .gitignore
# =============================================================================

# --- Carpeta de datos personales (PDFs de tarjetas) ---
data_cards/*
!data_cards/.gitkeep

# --- Archivos de salida generados ---
consumos_totales.csv
procesamiento_consumos.log
*.txt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
ENV/
env/
.venv/

# --- IDE / Editor ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- Jupyter Notebook ---
.ipynb_checkpoints/

# --- OS Files ---
.DS_Store
Thumbs.db
*.bak
*.tmp
*~

# --- Logs ---
*.log
logs/

# --- Environment variables ---
.env
.env.local

